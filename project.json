{
  "name": "koudaisai-portal",
  "parallel": 5,
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx run-many --target dev -p backend portal admin join --parallel 5 & caddy run --config dev/Caddyfile --adapter caddyfile"
      }
    },
    "dev-proxy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "caddy run --config dev/Caddyfile --adapter caddyfile"
      }
    },
    "local-registry": {
      "executor": "@nx/js:verdaccio",
      "options": {
        "port": 4873,
        "config": ".verdaccio/config.yml",
        "storage": "tmp/local-registry/storage"
      }
    }
  }
}
