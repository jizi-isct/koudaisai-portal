{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "customConditions": ["development"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [
    {
      "path": "../../libs/shared-ui"
    },
    {
      "path": "../../libs/shared-ui-document"
    },
    {
      "path": "../../libs/shared-api-utils"
    },
    {
      "path": "../../libs/shared-utils"
    },
    {
      "path": "../../libs/shared-types"
    }
  ]
}
