---
type Props = {
  title?: string;
  description?: string;
};

const {
  title = "工大祭ポータル",
  description = "このサイトは工大祭実行委員会公式の参加団体向けポータルサイトです。",
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    background: #f2f5ff;
    color: #171717;
    margin: 0;
  }
</style>
