---
export const prerender = false;
import {Heading1} from "@koudaisai/shared-ui";
import {ViewFormCards} from "@koudaisai-portal/shared-ui-forms";
import {getApiFetchClient} from "@koudaisai/shared-api";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import {API_URL} from "astro:env/client";

const fetchClient = getApiFetchClient(API_URL);
const {data, error} = await fetchClient.GET("/forms", {cache: "no-store"});

if (error || !data) {
  throw error;
}
---

<DefaultLayout title="フォーム | 工大祭参加登録サイト">
    <Heading1 emoji={"📝"}>フォーム</Heading1>
    <ViewFormCards forms={data}/>
</DefaultLayout>
