---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import {Faq, Heading1, Selector} from "@koudaisai/shared-ui";
import {questionDataNoLogin} from "../../features/questionData/questionDataNoLogIn";
import QuestionTitle from "./questionTitle.astro";
---

<DefaultLayout title="よくある質問 | 工大祭参加登録サイト">
    <section class="questions-page">
        <Heading1 emoji="❓">よくある質問</Heading1>
        <QuestionTitle title="～参加申請関連～" />
        {questionDataNoLogin["〜参加申請関連〜"].map((data, i) => (
            <Faq number={i+1} content={data}/>
        ))}
        <p>その他何かご不明などございましたら、当委員会までお気軽にお問い合わせください！</p>
    </section>
</DefaultLayout>