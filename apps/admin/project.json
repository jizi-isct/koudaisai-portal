{
  "name": "admin",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "implicitDependencies": [
    "@koudaisai/shared-api",
    "@koudaisai/shared-auth",
    "@koudaisai/shared-auth-admin",
    "@koudaisai/shared-types",
    "@koudaisai/shared-ui",
    "@koudaisai/shared-utils"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "astro build",
        "cwd": "apps/admin"
      },
      "dependsOn": ["^build"]
    },
    "build:production": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "astro build --mode production",
        "cwd": "apps/admin"
      },
      "dependsOn": ["^build"]
    },
    "build:preview": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "astro build --mode preview",
        "cwd": "apps/admin"
      },
      "dependsOn": ["^build"]
    },
    "deploy:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy",
        "cwd": "apps/admin"
      },
      "cache": false,
      "dependsOn": ["build:production"]
    },
    "deploy:preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "wrangler deploy --env preview",
        "cwd": "apps/admin"
      },
      "dependsOn": ["build:preview"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev --host 127.0.0.1 --port 3001",
        "cwd": "apps/admin"
      }
    }
  }
}
