---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout title="工大祭管理画面">
  <section class="admin-home">
    <img
      src="/logo.jpg"
      alt="Koudaisai Portal Admin Site Logo"
      width="150"
      height="150"
    />
    <h1>ようこそ</h1>
    <h2>ページ一覧</h2>
    <ul>
      <li><a href="/forms/">フォーム一覧</a></li>
      <li><a href="/documents/">資料一覧</a></li>
      <li><a href="/notifications/">通知一覧</a></li>
      <li><a href="/manage-users/">ユーザー管理画面</a></li>
    </ul>
  </section>
</DefaultLayout>

<style>
  .admin-home {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.4;
  }

  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style-position: inside;
  }

  a {
    color: var(--brand);
  }

  a:hover {
    text-decoration: underline;
  }
</style>
