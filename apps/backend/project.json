{
  "name": "backend",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --verbose",
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test",
        "cwd": "apps/backend"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --all -- --check",
        "cwd": "apps/backend"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check",
        "cwd": "apps/backend"
      }
    },
    "docker-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f ./debug/docker-compose.yml up -d --no-log-prefix --wait",
        "cwd": "apps/backend"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo watch -x run",
        "cwd": "apps/backend",
        "env": {
          "KOUDAISAI_PORTAL_CONFIG_PATH": "./debug/default-config.toml"
        }
      },
      "dependsOn": [
        "docker-up"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --all-targets --all-features -- -D warnings",
        "cwd": "apps/backend"
      }
    }
  }
}
