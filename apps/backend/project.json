{
  "name": "backend",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo build --release --verbose",
        "cwd": "apps/backend"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test",
        "cwd": "apps/backend"
      }
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt --all -- --check",
        "cwd": "apps/backend"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check",
        "cwd": "apps/backend"
      }
    },
    "dump-openapi": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"],
      "outputs": [
        "{workspaceRoot}/docs/api/api_v3/openapi.json",
        "{workspaceRoot}/docs/api/auth_v2/openapi.json"
      ],
      "options": {
        "cwd": "apps/backend",
        "parallel": false,
        "env": {
          "SQLX_OFFLINE": "true"
        },
        "commands": [
          "cargo run --quiet -- --dump-openapi=api_v3 > ../../docs/api/api_v3/openapi.json",
          "cargo run --quiet -- --dump-openapi=auth_v2 > ../../docs/api/auth_v2/openapi.json",
          "npx prettier --write ../../docs/api/api_v3/openapi.json ../../docs/api/auth_v2/openapi.json"
        ]
      }
    },
    "docker-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker-compose -f ./debug/docker-compose.yml up -d --no-log-prefix --wait",
        "cwd": "apps/backend"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo watch -x run",
        "cwd": "apps/backend",
        "env": {
          "KOUDAISAI_PORTAL_CONFIG_PATH": "./debug/default-config.toml"
        }
      },
      "dependsOn": ["docker-up"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy --all-targets --all-features -- -D warnings",
        "cwd": "apps/backend"
      }
    },
    "generate-rust-client": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "apps/backend",
        "parallel": false,
        "commands": [
          "rm -rf generated/events26_api",
          "curl -sSfL https://events26.koudaisai.jp/openapi.json -o generated/.events26_api.json --create-dirs",
          "openapi-generator-cli generate -i generated/.events26_api.json -g rust -t openapi-templates/rust -o generated/events26_api --additional-properties=library=reqwest,supportAsync=true,packageName=events26_api,packageVersion=0.1.0,avoidBoxedModels=true,useSingleRequestParameter=true,reqwestDefaultFeatures=rustls",
          "rm -f generated/.events26_api.json",
          "cargo fmt --manifest-path generated/events26_api/Cargo.toml --all"
        ]
      }
    }
  }
}
