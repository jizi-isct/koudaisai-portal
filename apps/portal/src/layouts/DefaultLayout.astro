---
import BaseLayout from "./BaseLayout.astro";

type Props = {
  title?: string;
  description?: string;
};

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class="default-layout-content">
    <slot />
  </main>
</BaseLayout>

<style>
  .default-layout-content {
    box-sizing: border-box;
    margin: 0 auto;
    max-width: 700px;
    min-height: 100vh;
    padding: 3rem 1rem;
    width: 100%;
  }
</style>
