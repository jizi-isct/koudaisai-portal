---
import DefaultLayout from "@/layouts/DefaultLayout.astro";
---

<DefaultLayout title="工大祭ポータル">
  <section class="portal-home">
    <h1>工大祭ポータル</h1>
    <p>Astro 版ポータルの移植作業を開始しました。</p>
  </section>
</DefaultLayout>

<style>
  .portal-home {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .portal-home h1 {
    color: var(--darkblue);
    font-size: 2rem;
    line-height: 1.3;
  }

  .portal-home p {
    line-height: 1.8;
  }
</style>
