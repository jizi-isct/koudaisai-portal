{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["development"],
    "jsx": "react-jsx",
    "paths": {
      "@koudaisai/shared-api": ["libs/shared-api/src/index.ts"]
    }
  },
  "@koudaisai/shared-types": ["libs/shared-types/src/index.ts"],
  "@koudaisai/shared-api": ["libs/shared-api/src/index.ts"],
  "@koudaisai/shared-utils": ["libs/shared-utils/src/index.ts"]
}
